<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    {% block title %}
        <title>ESPACE CLIENT</title>
    {% endblock %}

</head>
{% block body %}
    <h1>Nos produits</h1>

    <div class="product-grid">
        {% for produit in produits %}
            <div class="product-card">
                <div class="product-image">
                    <img src="{{ asset('uploads/images/' ~ produit.image) }}" alt="{{ produit.nom }}">
                </div>
                <div class="product-info">
                    <h2>{{ produit.nom }}</h2>
                    <p>{{ produit.description|slice(0, 100) ~ '...' }}</p>
                    <p><strong>Prix :</strong> {{ produit.prix }} dt</p>
                    <p><strong>Stock :</strong> {{ produit.quantiteEnStok }}</p>
                    <a class="product-link" href="{{ path('app_produit_show_client', {'id': produit.id}) }}">
                        <i class="fa fa-eye"></i> Voir les détails
                    </a>
                </div>
            </div>
        {% else %}
            <p>Aucun produit trouvé.</p>
        {% endfor %}
    </div>













    <footer>
        <p>© 2025 Votre Boutique. Tous droits réservés.</p>
    </footer>

    <style>
        /* Styles Globaux */
        body {
            background-color: rgba(0, 253, 164, 0.86); /* Couleur de secours */
            background-image: url("{{ asset('images/background.jpg') }}");
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            font-family: Arial, sans-serif;
        }

        h1 {
            text-align: center;
            margin: 20px 0;
            color: #333;
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin: 20px auto;
            max-width: 1000px;
        }

        .product-card {
            border: 1px solid #ddd;
            border-radius: 8px;
            overflow: hidden;
            background-color: #fff;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
        }

        .product-image img {
            width: 100%;
            height: 180px;
            object-fit: cover;
        }

        .product-info {
            padding: 15px;
            text-align: center;
        }

        .product-info h2 {
            font-size: 18px;
            margin-bottom: 10px;
        }

        .product-info p {
            margin: 5px 0;
            color: #555;
            font-size: 14px;
        }

        .product-link {
            display: inline-block;
            margin-top: 10px;
            padding: 10px 20px;
            background-color: #28a745;
            color: #fff;
            text-decoration: none;
            border-radius: 5px;
            font-size: 14px;
        }

        .product-link:hover {
            background-color: #218838;
        }


        /* Pied de page */
        footer {
            text-align: center;
            margin-top: 20px;
            padding: 10px 0;
            background: rgba(0, 0, 0, 0.8);
            color: #fff;
            font-size: 0.9em;
        }

        footer p {
            margin: 0;
        }
    </style>
{% endblock %}
</html>
